---
import "../styles/global.css";
import Footer from "../components/footer.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Announcements | SplashKit</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>

  <body class="bg-[#f5f1ea] text-[#17181C] antialiased">
    <header class="border-b border-[#E9E3D8] bg-[#f5f1ea]/85 backdrop-blur-md">
      <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
        <a href="/" class="flex items-center gap-2 text-lg font-bold text-[#17181C]" aria-label="SplashKit home">
          <img class="h-8 w-8" src="https://splashkit.io/_astro/favicon.ByGd77Wa.svg" alt="" />
          <span>SplashKit</span>
        </a>

        <div class="hidden items-center gap-8 lg:flex">
          <a href="/" class="text-sm font-medium text-[#17181C] transition hover:text-[#4B5563]">Home</a>
          <a href="/api" class="text-sm font-medium text-[#17181C] transition hover:text-[#4B5563]">Documentation</a>
          <a href="/guides" class="text-sm font-medium text-[#17181C] transition hover:text-[#4B5563]">Guides</a>
        </div>

        <div class="flex items-center gap-2">
          <a
            href="https://www.youtube.com/@splashkit7674"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-[#E5E0D8] bg-white text-[#17181C] transition hover:bg-[#f2eee8]"
            aria-label="YouTube"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/></svg>
          </a>

          <a
            href="https://github.com/splashkit"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-[#E5E0D8] bg-white text-[#17181C] transition hover:bg-[#f2eee8]"
            aria-label="GitHub"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          </a>

          <a
            href="/announcements"
            class="inline-flex items-center rounded-full bg-[#F8D54D] px-4 py-2 text-sm font-medium text-[#17181C] transition hover:bg-[#F2C82C]"
          >
            Announcements
          </a>
        </div>
      </nav>
    </header>

    <main>
      <section class="px-4 pt-7 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-6xl">
          <div class="relative flex h-[72vh] min-h-[440px] flex-col justify-end overflow-hidden rounded-[30px] border border-[#E9E3D8] bg-[#17181C] bg-[url('https://i.ibb.co/1t4YGC2g/billboard.png')] bg-cover bg-center bg-no-repeat shadow-[0_28px_60px_-30px_rgba(17,17,17,0.55)]">
            <div class="absolute inset-0 bg-gradient-to-t from-[#101014]/95 via-[#101014]/45 to-transparent"></div>

            <div class="relative z-10 max-w-2xl px-6 pb-10 sm:px-10 sm:pb-14 lg:px-12 lg:pb-16">
              <span class="inline-flex items-center rounded-full border border-white/15 bg-white/5 px-3 py-1.5 font-['JetBrains_Mono',monospace] text-[10px] uppercase tracking-[0.22em] text-[#F8D54D] backdrop-blur-sm">
                // splashkit/blog
              </span>

              <h1 class="mt-5 text-3xl font-semibold leading-[1.02] tracking-[-0.07em] text-white sm:text-5xl lg:text-6xl">
                Welcome to the SplashKit Blog
              </h1>

              <p class="mt-5 max-w-md text-sm leading-7 text-white/75 sm:text-base">
                SDK updates, website changes, game announcements, and community stories — all in one place.
              </p>

              <div class="mt-8 flex flex-wrap gap-3">
                <a
                  href="#expect"
                  class="inline-flex items-center gap-2 rounded-full bg-[#F8D54D] px-5 py-2.5 text-sm font-semibold text-[#17181C] transition hover:bg-[#F2C82C]"
                >
                  Explore the blog
                </a>

                <a
                  href="/announcements"
                  class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/5 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10"
                >
                  View changelog
                </a>
              </div>

              <div class="mt-8 flex flex-wrap items-center gap-4">
                <div class="flex items-center gap-2 text-xs uppercase tracking-[0.18em] text-white/70">
                  <span class="h-2.5 w-2.5 rounded-full bg-[#6DE5B5]"></span>
                  Weekly updates
                </div>
                <div class="flex items-center gap-2 text-xs uppercase tracking-[0.18em] text-white/70">
                  <span class="h-2.5 w-2.5 rounded-full bg-[#F8D54D]"></span>
                  Community stories
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="expect" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
        <div class="mx-auto max-w-2xl text-center">
          <p class="font-['JetBrains_Mono',monospace] text-[11px] font-medium tracking-[0.22em] text-[#6B7280]">
            // what's inside
          </p>
          <h2 class="mt-3 text-3xl font-semibold tracking-[-0.05em] text-[#17181C] sm:text-4xl">
            What you can expect
          </h2>
          <p class="mt-4 text-base leading-7 text-[#4B5563]">
            The SplashKit Blog is where product updates, tutorials, project highlights, and community wins come together in one clear, easy-to-follow space.
          </p>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
          <div class="rounded-[24px] border border-[#ECE9E2] bg-[#FBFAF7] p-6 shadow-[0_18px_36px_-28px_rgba(23,24,28,0.35)] transition hover:-translate-y-1 hover:border-[#F0D96D]">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-[#17181C] font-['JetBrains_Mono',monospace] text-[11px] font-semibold tracking-wide text-[#F8D54D]">
              upd
            </span>
            <h3 class="mt-5 text-lg font-semibold text-[#17181C]">News & Updates</h3>
            <p class="mt-2 text-sm leading-6 text-[#4B5563]">
              Get the inside scoop on new features, SDK improvements, and release milestones.
            </p>
          </div>

          <div class="rounded-[24px] border border-[#ECE9E2] bg-[#FBFAF7] p-6 shadow-[0_18px_36px_-28px_rgba(23,24,28,0.35)] transition hover:-translate-y-1 hover:border-[#F0D96D]">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-[#17181C] font-['JetBrains_Mono',monospace] text-[11px] font-semibold tracking-wide text-[#F8D54D]">
              web
            </span>
            <h3 class="mt-5 text-lg font-semibold text-[#17181C]">Website Improvements</h3>
            <p class="mt-2 text-sm leading-6 text-[#4B5563]">
              Follow the evolution of the platform with cleaner navigation and better discoverability.
            </p>
          </div>

          <div class="rounded-[24px] border border-[#ECE9E2] bg-[#FBFAF7] p-6 shadow-[0_18px_36px_-28px_rgba(23,24,28,0.35)] transition hover:-translate-y-1 hover:border-[#F0D96D]">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-[#17181C] font-['JetBrains_Mono',monospace] text-[11px] font-semibold tracking-wide text-[#F8D54D]">
              dev
            </span>
            <h3 class="mt-5 text-lg font-semibold text-[#17181C]">Game Announcements</h3>
            <p class="mt-2 text-sm leading-6 text-[#4B5563]">
              Hear about new game releases, updates, and standout projects built with SplashKit.
            </p>
          </div>

          <div class="rounded-[24px] border border-[#ECE9E2] bg-[#FBFAF7] p-6 shadow-[0_18px_36px_-28px_rgba(23,24,28,0.35)] transition hover:-translate-y-1 hover:border-[#F0D96D]">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-[#17181C] font-['JetBrains_Mono',monospace] text-[11px] font-semibold tracking-wide text-[#F8D54D]">
              oss
            </span>
            <h3 class="mt-5 text-lg font-semibold text-[#17181C]">Community Contributions</h3>
            <p class="mt-2 text-sm leading-6 text-[#4B5563]">
              Explore ways to contribute, share ideas, and help the platform grow together.
            </p>
          </div>
        </div>
      </section>

      <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 lg:px-8">
        <div class="relative overflow-hidden rounded-[30px] border border-[#E9E3D8] bg-[#101014] px-6 py-14 sm:px-10">
          <div
            class="pointer-events-none absolute inset-0 opacity-[0.12]"
            style="background-image: radial-gradient(circle at 1px 1px, #ffffff 1px, transparent 0); background-size: 22px 22px;"
          ></div>

          <div class="relative mx-auto max-w-2xl text-center">
            <p class="font-['JetBrains_Mono',monospace] text-[11px] font-medium tracking-[0.22em] text-[#00ACC1]">
              // get involved
            </p>

            <h2 class="mt-3 text-3xl font-semibold tracking-[-0.05em] text-white sm:text-4xl">
              Want to contribute?
            </h2>

            <p class="mt-4 text-sm leading-7 text-white/75 sm:text-base">
              If you're excited about SplashKit, there’s a place for you — from coding and testing to writing tutorials or helping shape the community.
            </p>

            <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
              <a
                href="https://github.com/splashkit"
                class="inline-flex items-center gap-2 rounded-full bg-[#00ACC1] px-5 py-2.5 text-sm font-semibold text-[#101014] transition hover:bg-[#3cc9d5]"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                View on GitHub
              </a>

              <a
                href="/guides"
                class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10"
              >
                Explore the docs
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>